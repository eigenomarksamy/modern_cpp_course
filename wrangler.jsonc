// Cloudflare Workers config: serves the rendered course in ./dist.
// `npm run build` creates it from site/course.json (generated together with
// modern_cpp_daily_course.md). There is no Worker script, static files only:
// /day/NN/ resolves to dist/day/NN/index.html, and unknown paths get 404.html.
// Docs: https://developers.cloudflare.com/workers/static-assets/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "modern-cpp-course",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Attaches the subdomain to this Worker and creates its DNS record on deploy.
  "routes": [{ "pattern": "cpp.eigenomar.com", "custom_domain": true }]
}
